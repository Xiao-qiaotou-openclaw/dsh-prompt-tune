{
  "name": "dsh-prompt-tune",
  "version": "0.1.0",
  "description": "Composer button that optimizes the unsent prompt with the configured DSH model, and undoes it. 输入框「优化提示词」按钮。",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "prompt",
    "prompt-engineering",
    "optimizer",
    "composer"
  ],
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "dsh": ">=0.1.2-rc.1"
  },
  "scripts": {
    "test": "npm run test:client && npm run test:host",
    "test:client": "node test/client-bundle.test.mjs",
    "test:host": "node test/host-route.test.mjs",
    "check": "node scripts/check-manifest.mjs",
    "verify": "npm run check && npm test",
    "prepack": "npm run check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": ">=0.1.2-rc.1 <0.2.0-0 || >=0.2.0-0 <2.0.0-0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
